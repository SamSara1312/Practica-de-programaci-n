mat1 = [[0,0],[0,0]]
mat2 = [[0,0],[0,0]]
suma = [[0,0],[0,0]]

print("Anota la primer matriz 2x2:")
for i in range(2):
    for j in range(2):
        mat1[i][j] = int(input("Ingresa un numero: "))

print("\nAnota la segunda matriz 2x2:")
for i in range(2):
    for j in range(2):
        mat2[i][j] = int(input("Ingresa un numero: "))

for i in range(2):
    for j in range(2):
        suma[i][j] = mat1[i][j] + mat2[i][j]

print("\n--- Matriz resultante ---")
for fila in suma:
    print(fila)